{
  "name": "libai-map",
  "private": true,
  "description": "An interactive map tracking Li Bai's travel throughout China, an accompaniment to Ha Jin's book The Banished Immortal",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/along": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.6.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kohzy/libai-map"
  }
}
